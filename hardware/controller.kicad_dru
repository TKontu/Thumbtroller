(version 1)

# The USB4105 land pattern puts the outer GND pads 0.175 mm from the part's own
# locating-peg holes. Board setup asks for 0.2 mm hole clearance (JLCPCB NPTH-to-copper),
# so allow this one footprint-internal case instead of carrying two permanent DRC errors.
(rule "USB4105 pad to own peg hole"
	(constraint hole_clearance (min 0.17mm))
	(condition "A.Reference == 'P1' && B.Reference == 'P1'"))
